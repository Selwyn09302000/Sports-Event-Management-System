# ---------------------------------------------------------------------------
# Local tournament server (Laptop A) — copy to .env and adjust
# ---------------------------------------------------------------------------
# SQLite file for the authoritative local store. Relative paths resolve from
# the project root. Put it on a disk you back up.
LOCAL_DB_PATH=./data/local.sqlite

# Leave COOKIE_SECURE unset for the gym LAN (plain HTTP). Set to true only when
# the app is served over HTTPS.
# COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Cloud (Supabase) — OPTIONAL. Leave blank to run fully offline.
# The service-role key is server-only. Never expose it as NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Must be exactly "true" before the sync endpoint will push anything.
SYNC_ENABLED=false
